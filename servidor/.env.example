# Copiar como .env y ajustar. El archivo .env NO se sube al repositorio.
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/innovation_hub
# Origen del cliente React permitido por CORS (varios separados por coma)
CORS_ORIGIN=http://localhost:5173
# Duración de la sesión en horas
SESSION_HOURS=12
BCRYPT_ROUNDS=10
